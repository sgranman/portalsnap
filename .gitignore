# Device capability reports POSTed by the probe pages — local diagnostics
reports/*.json

# Photos and clips kept from the Portal. They live beside the app because the
# device can't download them; they are not source.
media/

# Which devices are trusted, and which share links are live. Per-installation
# state, and the closest thing here to a secret — it holds hashes of the tokens
# in every paired device's cookie.
data/

# The test harness's own session, so a second test run doesn't need to claim
# the server again.
test/.session

node_modules/
.DS_Store

# Local tooling caches
.impeccable/
